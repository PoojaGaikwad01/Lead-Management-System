APP_NAME="Funky Monkey Leads"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=funky_leads
DB_USERNAME=funky
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SPA origins that receive session cookies (Vite dev server)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Created by "php artisan db:seed"
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@funkymonkey.local
SUPER_ADMIN_PASSWORD=

# Real-time (php artisan reverb:start). REVERB_APP_ID/KEY/SECRET are added by "php artisan reverb:install".
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Claude API (optional AI lead extraction; the app works without it)
AI_EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# WhatsApp connector: mock (default, local simulator) | chatwoot | periskope
WHATSAPP_PROVIDER=mock
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=
# Chatwoot webhook URL: https://<your-domain>/api/webhooks/whatsapp/chatwoot?token=<CHATWOOT_WEBHOOK_TOKEN>
CHATWOOT_WEBHOOK_TOKEN=
PERISKOPE_API_KEY=
PERISKOPE_PHONE=
PERISKOPE_WEBHOOK_TOKEN=
